APP_NAME="AI Builds My Website"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Database — MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_builds_my_website
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Web search (Exa) — used for the "Search the web" step.
# Without this key the search step is skipped with a visible note; nothing is faked.
EXA_API_KEY=

# AI provider: "openai-compatible" (default) or "gemini"
AI_PROVIDER=openai-compatible

# OpenAI-compatible endpoint (e.g. FastRouter). Used when AI_PROVIDER=openai-compatible.
AI_API_KEY=
AI_BASE_URL=https://api.fastrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# Gemini (free tier key from Google AI Studio). Used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# If no AI key is set at all, the app still works: it builds a deterministic
# facts-only website from the confirmed facts and says so on screen.
